# Copy this file to .env and fill in your values.
# Do not commit .env to version control.
# For physical Android phones, use your computer's LAN IP such as:
# BACKEND_BASE_URL=http://192.168.1.20:8000/api/v1
# WEBSOCKET_BASE_URL=ws://192.168.1.20:8000
# For Android emulator only, 10.0.2.2 is valid.
BACKEND_BASE_URL=http://10.0.2.2:8000/api/v1
WEBSOCKET_BASE_URL=ws://10.0.2.2:8000
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=
